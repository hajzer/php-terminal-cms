#!/usr/bin/env php
<?php
/**
 * Regenerates every derived file from its single source.
 *
 *   shared/langs.json -> editor/langs.js        (editor must work from file://,
 *                                                where fetch() is blocked)
 *                     -> site/shared/langs.json (the site reads it directly)
 *   shared/theme.css  -> editor/theme.css
 *                     -> site/public/theme.css
 *   shared/themes/<name>.json -> editor/themes/<name>.css       (one Theme,
 *                             -> site/public/themes/<name>.css   both halves;
 *                             -> editor/themes.js                 bin/themes.php
 *                                                                 says how)
 *   shared/mermaid.min.js -> editor/mermaid.min.js      (each half serves its
 *                         -> site/public/mermaid.min.js  own copy, from beside
 *                                                        the page that draws)
 *   docs/media/architecture.svg -> site/public/media/architecture.svg
 *                                  (the example site shows the diagram)
 *   editor/index.html -> tests/editor-probe.html  (the same page, with its
 *                                                  assets repathed, a watcher
 *                                                  for what the policy refuses
 *                                                  first in <head>, and the
 *                                                  probe script appended)
 *   editor/ -> site/editor/  (the Editor a Bundle carries, after the files
 *                             above that land in editor/ are written; each
 *                             copy keeps its source's mtime, which a Bundle
 *                             stamps it with, and a file editor/ no longer has
 *                             is taken out of the copy)
 *
 * bin/test fails if any copy has drifted from its source.
 */
declare(strict_types=1);

$root = dirname(__DIR__);

$json = file_get_contents($root . '/shared/langs.json');
if ($json === false || json_decode($json, true) === null) {
    fwrite(STDERR, "shared/langs.json missing or invalid\n");
    exit(1);
}

/* The browser probe is the editor's own page, so it cannot drift from it.
   Every relative asset in the page is repathed by shape rather than by a
   list, so that an asset added to the page needs no edit here. */
$page = (string) file_get_contents($root . '/editor/index.html');
$probe = (string) preg_replace_callback(
    /* a value with a scheme or a fragment in it is not a path beside the page,
       and the class excludes both, so only a path is ever matched at all */
    '~\b(href|src)="([^":#]+)"~',
    /* of those, an absolute path and a protocol-relative URL are addressed
       from somewhere other than this directory, so they stand as they are */
    static fn (array $m): string => str_starts_with($m[2], '/')
        ? $m[0]
        : $m[1] . '="../editor/' . $m[2] . '"',
    $page
);
$probe = str_replace(
    ['<meta charset="utf-8">' . "\n", '<title>php-terminal-cms — editor</title>', '</body>'],
    ['<meta charset="utf-8">' . "\n" . '<script src="editor-probe-watch.js"></script>' . "\n",
     '<title>php-terminal-cms — editor probe</title>',
     '<script src="editor-probe.js"></script>' . "\n" . '</body>'],
    $probe
);

$targets = [
    '/editor/langs.js' => "/* GENERATED from shared/langs.json by bin/build — do not edit. */\n"
                        . 'window.LANGS = ' . rtrim($json) . ";\n",
    '/site/shared/langs.json' => $json,
    '/editor/theme.css'       => file_get_contents($root . '/shared/theme.css'),
    '/site/public/theme.css'  => file_get_contents($root . '/shared/theme.css'),
    '/editor/mermaid.min.js'  => file_get_contents($root . '/shared/mermaid.min.js'),
    '/site/public/mermaid.min.js' => file_get_contents($root . '/shared/mermaid.min.js'),
    '/site/public/media/architecture.svg' => file_get_contents($root . '/docs/media/architecture.svg'),
    '/tests/editor-probe.html' => $probe,
] + (require $root . '/bin/themes.php')($root);

foreach ($targets as $rel => $content) {
    $path = $root . $rel;
    @mkdir(dirname($path), 0755, true);
    /* an unchanged file is not rewritten, so its mtime — the time a Bundle
       stamps it with — moves only when its bytes do */
    if (!is_file($path) || file_get_contents($path) !== (string) $content) {
        file_put_contents($path, $content);
    }
    printf("  %-28s %6d bytes\n", ltrim($rel, '/'), strlen((string) $content));
}

$from = $root . '/editor';
$to   = $root . '/site/editor';
$it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($from, FilesystemIterator::SKIP_DOTS));
$copied = 0;
foreach ($it as $f) {
    $rel = substr($f->getPathname(), strlen($from));
    @mkdir(dirname($to . $rel), 0755, true);
    if (!is_file($to . $rel) || md5_file($to . $rel) !== md5_file($f->getPathname())) {
        copy($f->getPathname(), $to . $rel);
    }
    touch($to . $rel, $f->getMTime());
    $copied++;
}
$it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($to, FilesystemIterator::SKIP_DOTS),
                                    RecursiveIteratorIterator::CHILD_FIRST);
foreach ($it as $f) {
    if (!file_exists($from . substr($f->getPathname(), strlen($to)))) {
        $f->isDir() ? rmdir($f->getPathname()) : unlink($f->getPathname());
    }
}
printf("  %-28s %6d files\n", 'site/editor/', $copied);
echo "build ok\n";
