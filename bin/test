       && TerminalCms\Page::html($site, $router->route($uri), 'N0NCE', $here)
          === TerminalCms\Page::html($site, $router->route($uri), 'N0NCE'),
       sprintf('%-36s is byte for byte what it was', $uri));
}

/* a built page's links end in a slash, and the request-time site answers them */
foreach (array_keys($before) as $uri) {
    if ($uri === '/' || $uri === '/404.html') {
        continue;
    }
    ok($router->route($uri . '/') === $router->route($uri), sprintf('%-36s answers with a trailing slash', $uri));
}

