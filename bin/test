ok(!str_contains(TerminalCms\Page::html($site, $sayMermaid), 'mermaid.render('),
   'a page whose text only says "mermaid" gets no drawing', $sayMermaid['body']);

$accents = [
    '#21e08a'                          => '#21e08a',
    '#ABCDEF'                          => '#ABCDEF',
    'red'                              => '#21e08a',
    '#fff'                             => '#21e08a',
    '#21e08a;background:url(//evil)'   => '#21e08a',
    '}html{display:none'               => '#21e08a',
];
foreach ($accents as $given => $want) {
    $accented = $site;
    $accented['accent'] = $given;
    ok(str_contains(TerminalCms\Page::html($accented, $home), '<style>:root{--accent:' . $want . '}</style>'),
       sprintf('accent %-32s -> %s', var_export($given, true), $want));
}

$noFoot = $site;
$noFoot['footer'] = '';
ok(foot($noFoot, $home) === '', 'an empty footer is no footer element at all');
