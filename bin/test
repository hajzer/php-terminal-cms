$base = "http://127.0.0.1:$port";
$up   = false;
for ($i = 0; $i < 40 && !$up; $i++) {
    usleep(100000);
    $up = @file_get_contents($base . '/') !== false;
}

if (!$up) {
    ok(false, 'development server started on port ' . $port);
} else {
    /* the bug this exists for: a router script sees every request, including
       real files, so index.php has to hand static assets back to the server */
    foreach (['/theme.css' => 'text/css', '/themes/baseline.css' => 'text/css', '/site.css' => 'text/css',
              '/favicon.ico' => 'image/'] as $path => $type) {
        $body = @file_get_contents($base . $path);
        $head = implode(' ', $http_response_header ?? []);
        ok(is_string($body) && !str_contains($body, '<!doctype html'),
           "$path is served as a file, not the 404 page");
        ok(str_contains(strtolower($head), $type), "$path has content-type $type", $head);
    }
    $doc = @file_get_contents($base . '/about/everything-is-a-line');
    ok(is_string($doc) && str_contains($doc, '<table>'), 'documents still route');

    /* the header is the policy, with the nonce the page's two inline points carry */
    $csp = '';
    foreach ($http_response_header ?? [] as $h) {
        if (stripos($h, 'Content-Security-Policy:') === 0) {
            $csp = trim(substr($h, strlen('Content-Security-Policy:')));
        }
    }
    preg_match_all('~\bnonce="([^"]*)"~', (string) $doc, $carried);
    $served = array_unique($carried[1]);
    ok(count($carried[1]) === 2 && count($served) === 1 && $csp === TerminalCms\Policy::forHeader($served[0]),
       'the page is sent with the policy as its header, naming the nonce it carries', $csp);
    ok(!str_contains((string) $doc, 'http-equiv'), 'and names no policy of its own');
    ok(@file_get_contents($base . '/nope') === false, 'unknown paths still 404');
}

if (is_resource($proc)) {
    proc_terminate($proc);
    proc_close($proc);
}
if ($temp) {
    unlink($cfg);
}

/* ---------------------------------------------------------- the page build */
echo "\npage build\n";

/* The build is run as a writer runs it, in a copy of the Instance, so that
   what it refuses and what it replaces are files nobody else needs. */
function copyTree(string $from, string $to): void
{
    mkdir($to, 0755, true);
    foreach (scandir($from) ?: [] as $name) {
        if ($name === '.' || $name === '..') {
            continue;
        }
        is_dir("$from/$name") ? copyTree("$from/$name", "$to/$name") : copy("$from/$name", "$to/$name");
    }
}

function removeTree(string $path): void
{
    if (is_link($path) || is_file($path)) {
        unlink($path);
        return;
    }
    if (!is_dir($path)) {
        return;
    }
    foreach (scandir($path) ?: [] as $name) {
        if ($name !== '.' && $name !== '..') {
            removeTree("$path/$name");
        }
    }
    rmdir($path);
}

/** Every path under a directory, with what each file holds: what "left as it
 *  was found" is compared by. @return array<string,string> */
function snapshot(string $dir): array
{
    $out = [];
    if (!is_dir($dir)) {
        return $out;
    }
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($it as $f) {
        $rel = substr($f->getPathname(), strlen($dir) + 1);
        $out[$rel] = $f->isDir() ? 'dir' : (string) md5_file($f->getPathname());
    }
    ksort($out);
    return $out;
}

/** @return array{0:int, 1:string} the exit status and what it printed */
function pageBuild(string $instance, array $args): array
{
    $cmd = array_merge([PHP_BINARY, $instance . '/bin/page-build'], $args);
    $proc = proc_open($cmd, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    $said = stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    return [proc_close($proc), $said];
}

/** Every local address a built page names, from href, src and the one data
 *  attribute that carries one. @return list<string> */
function localAddresses(string $html): array
{
    preg_match_all('~\b(?:href|src|data-mermaid)="([^"]*)"~', $html, $m);
    return array_values(array_filter(
        array_map('html_entity_decode', $m[1]),
        static fn (string $a) => preg_match('~^(#|[a-z][a-z0-9+.-]*:)~i', $a) !== 1
    ));
}

/** The file a host serves for a local address, or '' for none. */
function servedFile(string $out, string $address): string
{
    $path = rawurldecode((string) preg_replace('~[?#].*$~', '', $address));
    $file = $out . $path;
    if (str_ends_with($path, '/') || is_dir($file)) {
        $file = rtrim($file, '/') . '/index.html';
    }
    return is_file($file) ? $file : '';
}

$box = sys_get_temp_dir() . '/tcms-build-' . getmypid();
mkdir($box . '/instance/bin', 0755, true);
$box = (string) realpath($box);
$instance = $box . '/instance';
copy($root . '/bin/page-build', $instance . '/bin/page-build');
foreach (['src', 'shared', 'public', 'content'] as $dir) {
    copyTree($root . '/site/' . $dir, $instance . '/site/' . $dir);
}
copy($root . '/site/site.php.example', $instance . '/site/site.php');

$out = $box . '/out/pages';
[$status, $said] = pageBuild($instance, ['--output=' . $out, '--base-url=https://example.gitlab.io/proj/']);
ok($status === 0, 'the sample content builds with Base Path /proj', $said);

$expected = [
    'index.html', '404.html', '.page-build',
    'about/index.html', 'guides/index.html',
    'about/everything-is-a-line/index.html', 'about/what-it-is/index.html', 'about/what-it-is-sk/index.html',
    'guides/install-in-five-minutes/index.html', 'guides/publishing-is-a-file-copy/index.html',
