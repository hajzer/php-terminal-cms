    'media/logo.png', 'media/architecture.svg',
];
$files = array_keys(array_filter(snapshot($out), static fn (string $v) => $v !== 'dir'));
ok(array_diff($expected, $files) === [], 'every expected file is there',
   implode("\n", array_diff($expected, $files)));
$forbidden = array_filter($files, static fn (string $f) => str_ends_with($f, '.php') || basename($f) === '.htaccess');
ok($forbidden === [], 'and no .php and no .htaccess', implode("\n", $forbidden));
ok(file_get_contents($out . '/theme.css') === file_get_contents($root . '/site/public/theme.css')
   && file_get_contents($out . '/media/logo.png') === file_get_contents($root . '/site/public/media/logo.png'),
   'the public assets are copied as they are');

$pages = array_values(array_filter($files, static fn (string $f) => str_ends_with($f, '.html')));
$wrong = [];
foreach ($pages as $page) {
    foreach (localAddresses((string) file_get_contents("$out/$page")) as $a) {
        if (!str_starts_with($a, '/proj/')) {
            $wrong[] = "$page: $a does not start with /proj/";
        } elseif (servedFile($out, substr($a, strlen('/proj'))) === '') {
            $wrong[] = "$page: $a is no file in the output";
        }
    }
}
ok($wrong === [], 'every local href and src in every built page starts with /proj/ and resolves',
   implode("\n", array_slice($wrong, 0, 8)));
ok(str_contains((string) file_get_contents($out . '/index.html'), 'src="/proj/media/architecture.svg"'),
   'a root-relative Image src in the sample carries the Base Path');
$notFound = (string) file_get_contents($out . '/404.html');
ok(str_contains($notFound, '<h1>404</h1>') && str_contains($notFound, 'href="/proj/">back to the index'),
   '404.html is the site\'s 404 page, pointing home under the Base Path', $notFound);
ok(str_contains((string) file_get_contents($out . '/about/what-it-is-sk/index.html'), 'href="/proj/about/what-it-is/"'),
   'a Document\'s other Languages are linked with the trailing slash');

/**
 * The nonce a built page names in its policy, when the policy is a <meta> and
 * the first element of its <head>, and the nonce every inline point on the
 * page carries is that one; otherwise '' and why not.
 *
 * @return array{0:string, 1:string} the nonce, and what is wrong
 */
function builtNonce(string $html): array
{
    if (preg_match('~<head>\s*<([^>]*)>~', $html, $first) !== 1
        || preg_match('~^meta http-equiv="Content-Security-Policy" content="([^"]*)"$~', $first[1], $meta) !== 1) {
        return ['', 'the first element of <head> is <' . ($first[1] ?? '') . '>'];
    }
    $policy = html_entity_decode($meta[1], ENT_QUOTES | ENT_HTML5, 'UTF-8');
    if (preg_match("~'nonce-([^']+)'~", $policy, $n) !== 1 || $policy !== TerminalCms\Policy::forMeta($n[1])) {
        return ['', "the <meta> names $policy"];
    }
    preg_match_all('~<(\w+)[^>]*\bnonce="([^"]*)"~', $html, $carried, PREG_SET_ORDER);
    $tags = array_map(static fn (array $c) => $c[1], $carried);
    sort($tags);
    if ($tags !== ['script', 'style']) {
        return ['', 'nonces on ' . implode(', ', $tags)];
    }
    foreach ($carried as $c) {
        if ($c[2] !== $n[1]) {
            return ['', "<{$c[1]}> carries {$c[2]}, the policy names {$n[1]}"];
        }
    }
    return [$n[1], ''];
}

$nonces = [];
$wrong  = [];
foreach ($pages as $page) {
    [$nonce, $why] = builtNonce((string) file_get_contents("$out/$page"));
    $nonce === '' ? $wrong[] = "$page: $why" : $nonces[$nonce] = true;
}
ok($wrong === [], 'every built page\'s first <head> element is its policy, whose nonce is the one on its script and style',
   implode("\n", $wrong));
ok(count($nonces) === 1, 'and every page of one build names the same nonce', implode("\n", array_keys($nonces)));
$firstNonce = (string) array_key_first($nonces);

/**
 * A page with the three things a built one may differ in taken out: where its
 * policy is named, the Base Path in front of its local addresses, and the
 * trailing slash on its links. What is left is what the two ways to publish
 * must agree on to the byte. A served page is given no Base Path; a local
 * address on a built page that lacks the one it is given is marked, so that
 * it cannot pass for the served page's.
 */
function normalised(string $html, string $base): string
{
    $html = (string) preg_replace('~<head>\n<meta http-equiv="Content-Security-Policy" content="[^"]*">~', '<head>', $html, 1);
    if ($base !== '') {
        $under = preg_quote($base, '~');
        $html = (string) preg_replace('~\b(href|src|data-mermaid)="(?!' . $under . '/)(/(?!/))~', '$1="(no Base Path)$2', $html);
        $html = (string) preg_replace('~\b(href|src|data-mermaid)="' . $under . '(?=/)~', '$1="', $html);
    }
    return (string) preg_replace('~\bhref="(/[^"]+?)/"~', 'href="$1"', $html);
}

/**
 * Every page of a build set beside the page the request-time site serves for
 * its address, with the build's nonce: one line for each address where the
 * two differ, naming it and the first line that does.
 *
 * @param list<string> $pages the build's pages, relative to $out
 * @return list<string>
 */
function parity(string $out, array $pages, string $base, array $site, TerminalCms\Router $router): array
{
    $differ = [];
    foreach ($pages as $page) {
        $address = match (true) {
            $page === 'index.html'              => '/',
            str_ends_with($page, '/index.html') => '/' . substr($page, 0, -strlen('/index.html')),
            default                             => '/' . $page,
        };
        $built = (string) file_get_contents("$out/$page");
        [$nonce] = builtNonce($built);
        $built  = explode("\n", normalised($built, $base));
        $served = explode("\n", normalised(TerminalCms\Page::html($site, $router->route($address), $nonce), ''));
        for ($i = 0; $i < max(count($built), count($served)); $i++) {
            if (($built[$i] ?? null) !== ($served[$i] ?? null)) {
                $differ[] = "$address differs at line " . ($i + 1) . ":\n"
                          . '  built : ' . var_export($built[$i] ?? null, true) . "\n"
                          . '  served: ' . var_export($served[$i] ?? null, true);
                break;
            }
        }
    }
    return $differ;
}

$built = array_values(array_filter($pages, static fn (string $p) => basename($p) === 'index.html' || $p === '404.html'));
$differ = parity($out, $built, '/proj', $site, $router);
ok($differ === [] && count($built) === count($before)
   && in_array('about/everything-is-a-line/index.html', $built, true) && in_array('404.html', $built, true),
   'every built page is the page the site serves for its address, but for the Base Path, the slash and the policy\'s carrier',
   implode("\n", $differ) . "\n" . implode("\n", $built));

/* and a page that differs in anything else is named: one byte of its own, or
   a link without the Base Path */
copyTree($out, $box . '/tampered');
$tampered = $box . '/tampered/about/what-it-is/index.html';
file_put_contents($tampered, str_replace('</main>', '</main> ', (string) file_get_contents($tampered)));
$tampered = $box . '/tampered/guides/index.html';
file_put_contents($tampered, str_replace('href="/proj/about/"', 'href="/about/"', (string) file_get_contents($tampered)));
$differ = parity($box . '/tampered', $built, '/proj', $site, $router);
ok(count($differ) === 2 && str_starts_with($differ[0], '/about/what-it-is differs at line')
   && str_starts_with($differ[1], '/guides differs at line'),
   'a built page with one byte of its own, or a link without the Base Path, fails parity, naming its address',
   implode("\n", $differ));
removeTree($box . '/tampered');

/* no --base-url: the site begins at the host's root */
$rootOut = $box . '/root';
[$status, $said] = pageBuild($instance, ['--output=' . $rootOut]);
$wrong = [];
foreach ($pages as $page) {
    foreach (localAddresses((string) file_get_contents("$rootOut/$page")) as $a) {
        if (!str_starts_with($a, '/') || str_starts_with($a, '/proj') || servedFile($rootOut, $a) === '') {
            $wrong[] = "$page: $a";
        }
    }
}
ok($status === 0 && $wrong === [], 'built with no --base-url, every address starts at / and resolves',
   $said . implode("\n", array_slice($wrong, 0, 8)));
ok(str_contains((string) file_get_contents($rootOut . '/index.html'), 'class="brand" href="/"'),
   'and the brand is the host\'s root');
$differ = parity($rootOut, $built, '', $site, $router);
ok($differ === [], 'and every page is the served page but for the slash and the policy\'s carrier', implode("\n", $differ));
[$secondNonce] = builtNonce((string) file_get_contents($rootOut . '/index.html'));
ok($secondNonce !== '' && $firstNonce !== '' && $secondNonce !== $firstNonce,
   'two builds carry two different nonces', "$firstNonce\n$secondNonce");

/* a build over an earlier one replaces it; an empty directory is also fine */
file_put_contents($out . '/stale.html', 'from an earlier build');
[$status, $said] = pageBuild($instance, ['--output=' . $out, '--base-url=https://example.gitlab.io/proj']);
ok($status === 0 && !file_exists($out . '/stale.html') && is_file($out . '/index.html'),
   'a build replaces an earlier build whole', $said);
mkdir($box . '/empty');
[$status, $said] = pageBuild($instance, ['--output=' . $box . '/empty']);
ok($status === 0 && is_file($box . '/empty/.page-build'), 'and an empty directory', $said);

/* Refusals: each says why, exits non-zero, and leaves everything it was
   given as it found it — the Instance, the output and the directory beside
   it, so no fresh directory is left behind either. */
function refused(string $what, string $instance, array $args, string $box, string $expect): void
{
    $before = snapshot($box);
    [$status, $said] = pageBuild($instance, $args);
    ok($status !== 0 && str_contains($said, $expect) && snapshot($box) === $before,
       "refused: $what", "exit $status: $said");
}

mkdir($box . '/mine');
file_put_contents($box . '/mine/notes.txt', 'not a build');
refused('a non-empty output that is not a Page Build', $instance, ['--output=' . $box . '/mine'], $box, $box . '/mine');
refused('an output that is site/', $instance, ['--output=' . $instance . '/site'], $box, 'site/');
refused('an output that is content/', $instance, ['--output=' . $instance . '/site/content'], $box, 'content/');
refused('an output that is the repository root', $instance, ['--output=' . $instance], $box, 'repository root');
refused('an output that holds the repository root', $instance, ['--output=' . $box], $box, 'repository root');
refused('an output inside site/', $instance, ['--output=' . $instance . '/site/public/pages'], $box, 'site/');
foreach (['site', 'content'] as $held) {
    mkdir("$box/holds-$held/$held", 0755, true);
    touch("$box/holds-$held/.page-build");
    refused("a marked output that holds $held/", $instance, ["--output=$box/holds-$held"], $box, "$held/");
}
file_put_contents($box . '/a-file', 'x');
refused('an output that is a file', $instance, ['--output=' . $box . '/a-file'], $box, $box . '/a-file');
refused('no --output', $instance, [], $box, '--output');
refused('a misspelled flag', $instance, ['--output=' . $box . '/new', '--baseurl=/proj'], $box, '--baseurl=/proj');
refused('a flag given twice', $instance, ['--output=' . $box . '/new', '--output=' . $box . '/other'], $box, 'twice');
refused('a Base Path that is not one', $instance, ['--output=' . $out, '--base-url=https://h//evil.example/'], $box, 'Base Path');

rename($instance . '/site/site.php', $instance . '/site/site.php.off');
refused('no site.php', $instance, ['--output=' . $box . '/new'], $box,
        'site.php is missing — copy site.php.example to site.php and edit it.');
rename($instance . '/site/site.php.off', $instance . '/site/site.php');

/* A Document whose name is nothing but the extension, or dots before it, has
   no address a directory can hold. The build refuses it by name — the file,
   not the page it would have landed on. */
foreach (['.md', '..md', '...md'] as $dotted) {
    file_put_contents($instance . "/site/content/guides/$dotted", "# dots\n");
    [$status, $said] = pageBuild($instance, ['--output=' . $box . '/dots']);
    ok($status !== 0 && str_contains($said, "content/guides/$dotted has no address a directory can hold")
       && !file_exists($box . '/dots'),
       "a file named $dotted fails the build, naming the file", "exit $status: $said");
    unlink($instance . "/site/content/guides/$dotted");
}

/* A build that fails part-way — a Category page and a file in public/ at one
   address, found after the assets and the homepage are written — leaves the
   previous build where it was. */
mkdir($instance . '/site/public/guides');
file_put_contents($instance . '/site/public/guides/index.html', 'an asset where a page goes');
$before = snapshot($box);
[$status, $said] = pageBuild($instance, ['--output=' . $out, '--base-url=https://example.gitlab.io/proj']);
ok($status !== 0 && str_contains($said, 'guides/index.html') && snapshot($box) === $before,
   'a build that fails part-way leaves the previous build in place, and nothing beside it', "exit $status: $said");

removeTree($box);

/* ------------------------------------------------------- dangerous calls */
echo "\nsource\n";

/* Every file, every term it must not contain, as "file: term" lines. */
function scan(array $files, array $terms): array
{
    $found = [];
    foreach ($files as $f) {
        $code = (string) file_get_contents($f);
        foreach ($terms as $t) {
            if (str_contains($code, $t)) {
                $found[] = basename($f) . ': ' . $t;
            }
        }
    }
    return $found;
}

$found = scan(
    array_merge(glob($root . '/site/src/*.php') ?: [], [$root . '/site/public/index.php']),
    ['eval(', 'exec(', 'shell_exec', 'system(', 'passthru', 'popen',
     'unserialize(', 'extract(', 'assert(', '$_GET', '$_POST', '$_COOKIE',
     'file_put_contents', 'fwrite', 'unlink', 'session_start']
);
ok($found === [], 'the site reads, and does nothing else', implode("\n", $found));

/* The editor's requests are an <img src> the browser issues from markup, which
   a source scan cannot see, and — once the Document holds a Diagram — the
   <script> ui.js adds for its own copy of Mermaid, which the browser fetches
   because the element names it; this says the other half, that the page
   opens no connection by any other means. docs/security.md says what the
   markup causes.

   The terms are the calls that open a connection and the constructors that
   do — an Image, a worker, a peer connection — and the one call that opens a
   window. Setting `location` and clicking an anchor are navigations, and the
   export overlay clicks an anchor to hand over a download, so neither is on
   the list: a scan that fired on the download would have to be switched off.

   The two hand-written scripts are read. editor/langs.js is generated from
   shared/langs.json and is data, not code: its js table names fetch and eleven
   language tables name import, as words to colour. editor/mermaid.min.js is
   not read: it is third-party code, vendored unchanged, in which fetch(,
   Image(, Worker( and window.open( all appear, so a scan of it would report
   what the library contains rather than what the Editor does. What it may do
   on the page is bounded by `securityLevel: 'strict'` and, on the public
   site, the policy. */
$found = scan(
    [$root . '/editor/editor.js', $root . '/editor/ui.js'],
    ['fetch(', 'XMLHttpRequest', 'WebSocket', 'EventSource', 'sendBeacon', 'import(',
     'importScripts', 'Image(', 'Worker(', 'serviceWorker', 'RTCPeerConnection',
     'WebTransport', 'window.open(']
);
ok($found === [], 'the editor opens no connection', implode("\n", $found));

/* the one request there is carries the src the line names and nothing the
   page could have kept back: where the editor was opened from is not sent */
ok(str_contains((string) file_get_contents($root . '/editor/index.html'),
                '<meta name="referrer" content="no-referrer">'),
   'and the one request it causes carries no referrer');

echo "\n$pass passed, $fail failed\n";
exit($fail === 0 ? 0 : 1);
