#!/usr/bin/env php
<?php
/**
 * The whole test suite. No framework — it asserts the handful of things that
 * would actually break the system, and nothing else.
 */
declare(strict_types=1);

use TerminalCms\Highlighter;
use TerminalCms\Line;
use TerminalCms\Markdown;
use TerminalCms\Renderer;

$root = dirname(__DIR__);
require $root . '/site/src/bootstrap.php';
Highlighter::load($root . '/shared/langs.json');

$pass = 0;
$fail = 0;

function ok(bool $cond, string $what, string $detail = ''): void
{
    global $pass, $fail;
    if ($cond) {
        $pass++;
        echo "  ok   $what\n";
    } else {
        $fail++;
        echo "  FAIL $what\n";
        if ($detail !== '') {
            foreach (explode("\n", $detail) as $l) {
                echo "       $l\n";
            }
        }
    }
}

function diff(string $a, string $b): string
{
    $x = explode("\n", $a);
    $y = explode("\n", $b);
    $out = [];
    for ($i = 0; $i < max(count($x), count($y)); $i++) {
        if (($x[$i] ?? null) !== ($y[$i] ?? null)) {
            $out[] = sprintf('line %d:', $i + 1);
            $out[] = '  php: ' . var_export($x[$i] ?? null, true);
            $out[] = '  js : ' . var_export($y[$i] ?? null, true);
            if (count($out) > 12) {
                break;
            }
        }
    }
    return implode("\n", $out);
}

/* ------------------------------------------------ the version, in both places */
echo "version\n";
$version = trim((string) file_get_contents($root . '/VERSION'));
ok(preg_match('~^\d+\.\d+\.\d+$~', $version) === 1, 'VERSION is a version', $version);
ok(str_contains((string) file_get_contents($root . '/editor/index.html'),
                '<i class="ver">' . $version . '</i>'),
   'the editor shows the version in VERSION',
   "editor/index.html does not say $version");

/* ------------------------------------- the archive is the repository layout */
echo "\nrelease manifest\n";
$manifest = require $root . '/bin/manifest.php';

$gone = array_values(array_filter(
    $manifest['include'],
    static fn (string $rel) => !file_exists($root . '/' . $rel)
));
ok($gone === [], 'every path bin/manifest.php names exists', implode("\n", $gone));

/* An archive that is not the repository cannot seed one, and the way that
   happens is a file being added to git and nobody remembering the manifest. */
if (!is_dir($root . '/.git') || trim((string) shell_exec('command -v git 2>/dev/null')) === '') {
    echo "  -- not a git checkout, skipping the tracked-file comparison\n";
} else {
    $covered = array_merge($manifest['include'], $manifest['repo']);
    $tracked = array_filter(explode("\n",
        (string) shell_exec('git -C ' . escapeshellarg($root) . ' ls-files')));

    $missed = [];
    foreach ($tracked as $file) {
        foreach ($covered as $rel) {
            if ($file === $rel || str_starts_with($file, $rel . '/')) {
                continue 2;
            }
        }
        $missed[] = $file;
    }
    ok($missed === [], 'and every tracked file is named by it',
       implode("\n", array_slice($missed, 0, 8)));
}

/* ------------------------------------------------ derived files are current */
echo "\nderived files\n";
$checks = [
    '/editor/langs.js'        => "/* GENERATED from shared/langs.json by bin/build — do not edit. */\n"
                               . 'window.LANGS = ' . rtrim((string) file_get_contents($root . '/shared/langs.json')) . ";\n",
    '/site/shared/langs.json' => (string) file_get_contents($root . '/shared/langs.json'),
    '/editor/theme.css'       => (string) file_get_contents($root . '/shared/theme.css'),
    '/site/public/theme.css'  => (string) file_get_contents($root . '/shared/theme.css'),
];
/* the probe page is the editor page; undo the rewrites bin/build makes and
   what is left has to be byte-identical to editor/index.html */
$probe = (string) @file_get_contents($root . '/tests/editor-probe.html');
$back  = str_replace(
    ['../editor/', '<script src="editor-probe.js"></script>' . "\n", ' probe</title>'],
    ['', '', '</title>'],
    $probe
);
ok($probe !== '' && $back === (string) file_get_contents($root . '/editor/index.html'),
   '/tests/editor-probe.html matches editor/index.html', 'run bin/build');

/* An asset the rewrite missed matches anyway once the rewrite is undone, so
   the comparison above is blind to exactly the mistake that breaks the probe:
   a page asset the probe asks for relative to tests/ and does not get. */
preg_match_all('~\b(?:href|src)="([^":#]+)"~', $probe, $refs);
$lost = array_values(array_filter(
    array_unique($refs[1]),
    static fn (string $rel): bool => !str_starts_with($rel, '/')
        && !is_file($root . '/tests/' . $rel)
));
ok($lost === [], 'and every asset it names is a file that exists',
   implode("\n", $lost) . "\n" . 'run bin/build');
foreach ($checks as $rel => $want) {
    ok(is_file($root . $rel) && file_get_contents($root . $rel) === $want,
       "$rel matches its source", 'run bin/build');
}

/* ------------------------------------------------------- dialects and prompts
 *
 * The dialect tables exist twice — editor/editor.js and site/src/Line.php — and
 * the language tables once, in shared/langs.json. Everything below is a way for
 * those three to disagree without anybody noticing until a file round trips
 * wrong on somebody else's machine. */
echo "\ndialects\n";
$langs = json_decode((string) file_get_contents($root . '/shared/langs.json'), true) ?: [];
$bad = [];
foreach ($langs as $name => $L) {
    if ($name === '_comment') {
        continue;
    }
    if (isset($L['like'])) {
        if (!isset($langs[$L['like']]) || isset($langs[$L['like']]['like'])) {
            $bad[] = "$name: like points at " . $L['like'] . ', which is not a definition';
        }
        continue;
    }
    foreach (['com', 'str', 'var'] as $k) {
        $src = $L[$k] ?? null;
        if ($src === null) {
            continue;
        }
        /* the PHP tokenizer wraps these in ~...~, so a ~ would end the pattern */
        if (str_contains($src, '~')) {
            $bad[] = "$name.$k: contains ~, which is the PHP delimiter";
        }
        if (@preg_match('~' . $src . '~A', 'probe') === false) {
            $bad[] = "$name.$k: is not a valid pattern";
        }
    }
}
ok($bad === [], 'every language table is usable by both tokenizers', implode("\n", $bad));

$tables = null;
$node   = trim((string) shell_exec('command -v node 2>/dev/null'));
if ($node !== '') {
    $tables = json_decode(
        (string) shell_exec($node . ' ' . escapeshellarg($root . '/tests/js-tables.js')),
        true
    );
}
if (!is_array($tables)) {
    echo "  -- node not installed, skipping the editor's half of the tables\n";
} else {
    ok($tables['prompts'] === Line::PROMPTS,
       'the editor and the site agree on the CLI prompts',
       "js : " . json_encode($tables['prompts']) . "\nphp: " . json_encode(Line::PROMPTS));

    $missing = array_values(array_filter(
        array_merge($tables['code'], $tables['cli']),
        static fn (string $d) => !isset($langs[$d])
    ));
    ok($missing === [], 'every dialect the editor offers has a language table',
       implode(' ', $missing));

    $reserved = array_values(array_intersect(
        array_merge($tables['code'], $tables['cli']),
        ['output', 'text', 'console', 'shell-session', 'terminal']
    ));
    ok($reserved === [], 'no dialect collides with a fence word that means something else',
       implode(' ', $reserved));

    /* the tokenizers are two implementations of one table: the same line, in
       the same dialect, has to come out as the same bytes on both sides */
    $drift = [];
    foreach ($tables['highlighted'] as $dialect => $wanted) {
        foreach ($tables['samples'] as $k => $sample) {
            $got = Highlighter::highlight($sample, (string) $dialect);
            if ($got !== $wanted[$k]) {
                $drift[] = "$dialect sample $k\n  php: $got\n  js : {$wanted[$k]}";
            }
        }
    }
    ok($drift === [], 'both tokenizers highlight every dialect identically',
       implode("\n", array_slice($drift, 0, 4)));
}

/* the round trip a duplicated prompt would silently break */
$wrong = [];
foreach (Line::PROMPTS as $dialect => $prompt) {
    [, $back] = Markdown::parse("```console\n$prompt hello\n```\n");
    if (count($back) !== 1 || $back[0]->type !== 'cli'
        || $back[0]->sub !== $dialect || $back[0]->text !== 'hello') {
        $wrong[] = $dialect . ' -> ' . ($back[0]->sub ?? '?') . ' ' . ($back[0]->text ?? '');
    }
}
ok($wrong === [], 'every CLI prompt reads back as the dialect that wrote it',
   implode("\n", $wrong));

/* a table row whose cells are all empty is a row — the editor opens one every
   time `o` adds a row to a run, and it has to survive the trip through a file */
$emptyRow = "| a | b | c |\n| --- | --- | --- |\n|  |  |  |\n";
[, $rowLines] = Markdown::parse($emptyRow);
ok(count($rowLines) === 2, 'an empty table row reads back as a row', (string) count($rowLines));
ok($rowLines[1]->text === ' |  | ', 'and keeps the cells it was written with',
   var_export($rowLines[1]->text ?? null, true));
ok(Markdown::toMarkdown($rowLines) === $emptyRow,
   'a table with an empty row round trips', diff($emptyRow, Markdown::toMarkdown($rowLines)));
[, $alignLines] = Markdown::parse("| a |\n| :-: |\n");
ok(count($alignLines) === 1, 'the alignment row itself is still not a line',
   (string) count($alignLines));

/* --------------------------------------------------- the editor's own model */
if ($node === '') {
    echo "\neditor model\n  -- node not installed, skipping tests/js-model.js\n";
} else {
    echo "\neditor model\n";
    $raw = shell_exec($node . ' ' . escapeshellarg($root . '/tests/js-model.js'));
    $cases = json_decode((string) $raw, true);
    if (!is_array($cases)) {
        ok(false, 'the editor model suite ran', (string) $raw);
    } else {
        foreach ($cases as $case) {
            ok((bool) $case['ok'], (string) $case['name'], (string) $case['detail']);
        }
    }
}

/* ------------------------------------------------------ round trip, per file */
$files = [];
foreach (['index.md', 'about/index.md', 'about/what-it-is.md', 'about/what-it-is-sk.md',
          'about/everything-is-a-line.md', 'guides/index.md',
          'guides/install-in-five-minutes.md', 'guides/writing-in-the-editor.md',
          'guides/publishing-is-a-file-copy.md'] as $f) {
    $files[] = $root . '/site/content/' . $f;
}

foreach ($files as $file) {
    $name = str_replace($root . '/site/content/', '', $file);
    echo "\n$name\n";

    $src = (string) file_get_contents($file);
    [, $lines] = Markdown::parse($src);

    $once  = Markdown::toMarkdown($lines);
    [, $l2] = Markdown::parse($once);
    $twice = Markdown::toMarkdown($l2);

    ok($once === $twice, 'php round trip is stable', diff($once, $twice));
    ok($once === $src, 'php output is byte-identical to the source file', diff($src, $once));

    if ($node === '') {
        continue;
    }

    $raw = shell_exec($node . ' ' . escapeshellarg($root . '/tests/js-dump.js') . ' ' . escapeshellarg($file));
    $js  = json_decode((string) $raw, true);
    if (!is_array($js)) {
        ok(false, 'js dump parsed', (string) $raw);
        continue;
    }

    $phpTypes = array_map(
        static fn (Line $l) => $l->type . ($l->sub !== null ? ':' . $l->sub : ''),
        $lines
    );
    ok($phpTypes === $js['types'], 'php and js agree on the line types',
       "php: " . implode(' ', $phpTypes) . "\njs : " . implode(' ', $js['types']));

    ok($once === $js['markdown'], 'php and js emit identical markdown',
       diff($once, $js['markdown']));

    $phpBlocks = array_map(
        static function (string $l): string {
            return preg_match('~^<([a-z0-9]+)~i', $l, $m) === 1 ? $m[1] : '?';
        },
        explode("\n", Renderer::render($lines, false))
    );
    $jsBlocks = array_values(array_filter($js['blocks'], static fn ($b) => $b !== '?'));
    $phpBlocks = array_values(array_filter($phpBlocks, static fn ($b) => $b !== '?'));
    ok($phpBlocks === $jsBlocks, 'php and js render the same block sequence',
       "php: " . implode(' ', $phpBlocks) . "\njs : " . implode(' ', $jsBlocks));
}

/* ------------------------------------------------------------- line breaks */
echo "\nline breaks\n";

/* the three forms a file can be written with, all one break */
foreach (['LF' => "\n", 'CRLF' => "\r\n", 'CR' => "\r"] as $name => $eol) {
    [, $ls] = Markdown::parse("# T{$eol}{$eol}a{$eol}");
    ok(count($ls) === 2 && $ls[1]->text === 'a', "$name is one line break", $name);
}

/* A UTF-8 continuation byte is not a line break. PCRE's \R without the u
   modifier matches the byte 0x85, which is the last byte of every character
   whose code point ends in 0x05, so these were cut in half and lost a byte. */
foreach (['★' => 'U+2605', 'х' => 'U+0445', 'Ņ' => 'U+0145'] as $ch => $point) {
    $src = "---\ntitle: T\n---\n\n# T\n\na {$ch} b\n";
    [, $ls] = Markdown::parse($src);
    $para = end($ls);
    ok($para->type === 'p' && $para->text === "a {$ch} b",
       "$point survives the parser whole", bin2hex($para->text));
    ok(Markdown::toMarkdown($ls) === $src, "$point round trips byte for byte");
}

/* ---------------------------------------------------------------- escaping */
echo "\nescaping\n";
$evil = "---\ntitle: <script>alert(1)</script>\n---\n\n"
      . "# <img src=x onerror=alert(1)>\n\n"
      . "A paragraph with <b>tags</b> and a [link](javascript:alert(1)).\n\n"
      . "```html\n<script>alert(1)</script>\n```\n\n"
      . "| <script>x</script> | b |\n| --- | --- |\n| c | d |\n";
[, $evilLines] = Markdown::parse($evil);
$html = Renderer::render($evilLines);

ok(preg_match('~<\s*script~i', $html) !== 1, 'no <script> survives the renderer', $html);
ok(preg_match('~<[^>]*\bon[a-z]+\s*=~i', $html) !== 1,
   'no event handler survives the renderer', $html);
ok(!str_contains($html, 'javascript:'), 'javascript: links are dropped', $html);
ok(str_contains($html, '&lt;script&gt;'), 'the text is preserved, escaped');
ok(str_contains($html, '<b>tags</b>') === false, 'inline html is escaped, not passed through');

/* ------------------------------------------------------------ link targets */
echo "\nlink targets\n";

/* One list, read by both halves. A target that is not on the allowlist leaves
   the writing behind and takes the link away — it never becomes an href. */
$links = [
    '[x](/guides/a)'                  => true,
    '[x](/guides/v1.2-notes)'         => true,
    '[x](#a-heading)'                 => true,
    '[x](#)'                          => true,
    '[x](https://example.com/)'       => true,
    '[x](http://example.com/?a=1&b=2)' => true,
    '[x](mailto:you@example.com)'     => true,
    /* an origin, a climb and a path separator, all dressed as local paths */
    '[x](//evil.example)'             => false,
    '[x](/../secret)'                 => false,
    '[x](/a/../../secret)'            => false,
    '[x](&#47;&#47;evil.example)'     => false,
    '[x](\\evil.example)'             => false,
    '[x](http:///evil.example)'       => false,
    /* not a scheme this renderer emits */
    '[x](javascript:void)'            => false,
    '[x](data:text/html,x)'           => false,
    '[x](vbscript:x)'                 => false,
    '[x](ftp://example.com/)'         => false,
    '[x](mailto:not-an-address)'      => false,
    '[x](relative.html)'              => false,
];
foreach ($links as $case => $isLink) {
    $out = Renderer::inline($case);
    ok(str_contains($out, '<a href=') === $isLink,
       sprintf('%-34s %s', $case, $isLink ? 'is a link' : 'is not a link'), $out);
}
ok(str_contains(Renderer::inline('[x](https://example.com/)'), 'rel="noopener noreferrer"'),
   'an external link carries rel="noopener noreferrer"');
ok(!str_contains(Renderer::inline('[x](/guides/a)'), 'rel='),
   'and a local one has nothing to carry');

/* link_open, in the bytes: a target is for a link that leaves the site, which
   is the same set that carries rel — and the one-argument call is the page
   every instance had before the setting existed. */
$targets = [
    '[x](https://example.com/)'   => true,
    '[x](http://example.com/)'    => true,
    '[x](/guides/a)'              => false,
    '[x](#a-heading)'             => false,
    '[x](mailto:you@example.com)' => false,
];
foreach ($targets as $case => $opens) {
    $out = Renderer::inline($case, 'tab');
    ok(str_contains($out, ' target="_blank"') === $opens,
       sprintf("'tab' %-30s %s", $case, $opens ? 'opens a new tab' : 'opens here'), $out);
}
ok(str_contains(Renderer::inline('[x](https://example.com/)', 'tab'),
                'rel="noopener noreferrer" target="_blank"'),
   "and the target is emitted beside the rel, not instead of it");
foreach (['here', '', 'yes', 'blank'] as $mode) {
    ok(!str_contains(Renderer::inline('[x](https://example.com/)', $mode), 'target='),
       sprintf('%-8s leaves the reader where they are', var_export($mode, true)));
}
ok(Renderer::inline('[x](https://example.com/) **b** `c`')
   === Renderer::inline('[x](https://example.com/) **b** `c`', 'here'),
   'and a call that names no mode renders the one that opens here');

/* The editor previews a document by rendering it, so its allowlist has to be
   the same one — a link in the preview that the site drops, or the other way
   round, means the preview is not what the site would send. */
if ($node === '') {
    echo "  -- node not installed, skipping the editor's copy\n";
} else {
    $cases = array_keys($links);
    $tmp   = sys_get_temp_dir() . '/tcms-links-' . getmypid() . '.json';
    file_put_contents($tmp, json_encode($cases));
    $raw = shell_exec($node . ' ' . escapeshellarg($root . '/tests/js-inline.js') . ' ' . escapeshellarg($tmp));
    unlink($tmp);
    $js = json_decode((string) $raw, true);
    if (!is_array($js)) {
        ok(false, 'the editor inline dump ran', (string) $raw);
    } else {
        $drift = [];
        foreach ($cases as $k => $case) {
            $php = Renderer::inline($case);
            if (($js[$k] ?? null) !== $php) {
                $drift[] = "$case\n  php: $php\n  js : " . var_export($js[$k] ?? null, true);
            }
        }
        ok($drift === [], 'the editor and the site render every link identically',
           implode("\n", array_slice($drift, 0, 4)));
    }
}

/* ------------------------------------------------------------------ router */
echo "\nrouting\n";
$site = require $root . '/site/site.php.example';
$router = new TerminalCms\Router($site, $root . '/site/content');

$cases = [
    '/'                                  => 200,
    '/about'                             => 200,
    '/guides'                            => 200,
    '/about/everything-is-a-line'        => 200,
    '/about/what-it-is'                  => 200,
    '/about/what-it-is-sk'               => 200,
    '/about/everything-is-a-line-sk'     => 404,
    '/guides/install-in-five-minutes'    => 200,
    '/guides/does-not-exist'             => 404,
    '/not-a-category'                    => 404,
    '/not-a-category/x'                  => 404,
    '/guides/../../etc/passwd'           => 404,
    '/guides/%2e%2e%2f%2e%2e%2fetc/passwd' => 404,
    '/guides/index'                      => 200,
    '/a/b/c'                             => 404,
    /* parse_url cannot read these as a path at all, and a client may send them */
    '//'                                 => 200,
    '///'                                => 200,
];
foreach ($cases as $uri => $want) {
    $r = $router->route($uri);
    ok($r['status'] === $want, sprintf('%-40s -> %d', $uri, $want), 'got ' . $r['status']);
}

/* a slug declared in site.php with nothing behind it is empty, not an error */
$ghost = $site;
$ghost['categories'][] = ['slug' => 'ghost', 'label' => 'ghost'];
$warnings = [];
set_error_handler(static function (int $n, string $m) use (&$warnings): bool {
    $warnings[] = $m;
    return true;
});
$ghostRouter = new TerminalCms\Router($ghost, $root . '/site/content');
$empty = $ghostRouter->route('/ghost');
$gone  = $ghostRouter->route('/ghost/anything');
restore_error_handler();
ok($warnings === [], 'a category with no directory raises nothing', implode("\n", $warnings));
ok($empty['status'] === 200 && $gone['status'] === 404,
   'and is an empty category, not a broken one',
   $empty['status'] . ' ' . $gone['status']);

/* a category entry that is not a category is ignored, not turned into a path */
$broken = $site;
$broken['categories'] = array_merge([
    'not-an-array',
    ['label' => 'no slug'],
    ['slug' => '../../etc', 'label' => 'climb'],
    ['slug' => 'Upper', 'label' => 'not a directory name'],
], $site['categories']);
$warnings = [];
set_error_handler(static function (int $n, string $m) use (&$warnings): bool {
    $warnings[] = $m;
    return true;
});
$brokenRouter = new TerminalCms\Router($broken, $root . '/site/content');
$stillHere = $brokenRouter->route('/guides')['status'];
$climb     = $brokenRouter->route('/../../etc')['status'];
$upper     = $brokenRouter->route('/Upper')['status'];
$nav       = TerminalCms\Page::html($broken, $brokenRouter->route('/'));
restore_error_handler();
ok($warnings === [], 'a malformed category entry raises nothing', implode("\n", $warnings));
ok($stillHere === 200 && $climb === 404 && $upper === 404,
   'and is unroutable, while the categories beside it still route',
   "$stillHere $climb $upper");
ok(!str_contains($nav, 'climb') && !str_contains($nav, 'no slug'),
   'and is not in the navigation either', $nav);

/* A document is found by comparing the request with the real file names, so a
   file named in a way no slug rule would predict is still reachable — and is
   reachable by the address its own listing prints. */
$scratch = sys_get_temp_dir() . '/tcms-content-' . getmypid();
mkdir($scratch . '/notes', 0755, true);
file_put_contents($scratch . '/notes/Release-1.2.md', "---\ntitle: Release 1.2\n---\n\n# Release 1.2\n\nText.\n");
$oddRouter = new TerminalCms\Router(['categories' => [['slug' => 'notes', 'label' => 'notes']]], $scratch);
$odd = $oddRouter->route('/notes/Release-1.2');
ok($odd['status'] === 200, 'a file name with a dot and a capital is still a document', (string) $odd['status']);
ok(str_contains($oddRouter->route('/notes')['body'], 'href="/notes/Release-1.2"'),
   'and the listing links to the address that works', $oddRouter->route('/notes')['body']);
unlink($scratch . '/notes/Release-1.2.md');
rmdir($scratch . '/notes');
rmdir($scratch);

/* ------------------------------------------------------- the index listings */
echo "\nlistings\n";

$listed = $router->route('/');
ok(str_contains($listed['body'], '<ul class="listing">'),
   'the homepage lists recent documents by default');
ok(str_contains($router->route('/guides')['body'], '<ul class="listing">'),
   'and so does a category page');

$quiet = $site;
$quiet['listing'] = false;
$quietRouter = new TerminalCms\Router($quiet, $root . '/site/content');
$body = $quietRouter->route('/')['body'];
ok(!str_contains($body, '<ul class="listing">') && !str_contains($body, 'Nothing here yet.'),
   "'listing' => false leaves the homepage its index.md and nothing else", $body);
ok(str_contains($quietRouter->route('/guides')['body'], '<ul class="listing">'),
   'and says nothing about the categories');

$quietCat = $site;
foreach ($quietCat['categories'] as $i => $c) {
    if ($c['slug'] === 'guides') {
        $quietCat['categories'][$i]['listing'] = false;
    }
}
$catRouter = new TerminalCms\Router($quietCat, $root . '/site/content');
$body = $catRouter->route('/guides')['body'];
ok(!str_contains($body, '<ul class="listing">'),
   'a category can switch its own listing off', $body);
ok(str_contains($catRouter->route('/about')['body'], '<ul class="listing">'),
   'without switching off the one next to it');
ok(str_contains($catRouter->route('/')['body'], '<ul class="listing">'),
   'or the homepage, which still lists documents from both');

/* a site.php that names no listing setting lists everywhere */
$older = $site;
unset($older['listing']);
foreach ($older['categories'] as $i => $c) {
    unset($older['categories'][$i]['listing']);
}
$olderRouter = new TerminalCms\Router($older, $root . '/site/content');
ok(str_contains($olderRouter->route('/')['body'], '<ul class="listing">')
   && str_contains($olderRouter->route('/guides')['body'], '<ul class="listing">'),
   'a site.php that names no listing setting lists everywhere');

/* listing_max — how many documents the homepage prints. It takes a content
   directory bigger than the default to see a default at all, so this one is
   built rather than borrowed. */
$many = sys_get_temp_dir() . '/tcms-many-' . getmypid();
mkdir($many . '/notes', 0755, true);
mkdir($many . '/logs', 0755, true);
foreach (range(1, 12) as $i) {
    file_put_contents(sprintf('%s/notes/note-%02d.md', $many, $i),
        sprintf("---\ntitle: Note %02d\ndate: 2026-01-%02d\n---\n\nText.\n", $i, $i));
}
foreach (range(1, 8) as $i) {
    file_put_contents(sprintf('%s/logs/log-%02d.md', $many, $i),
        sprintf("---\ntitle: Log %02d\ndate: 2026-02-%02d\n---\n\nText.\n", $i, $i));
}
$manySite = ['title' => 'many', 'categories' => [
    ['slug' => 'notes', 'label' => 'notes'],
    ['slug' => 'logs',  'label' => 'logs'],
]];

/** How many documents a page lists, at the seam the reader meets. */
function listed(array $site, string $contentDir, string $uri): int
{
    $router = new TerminalCms\Router($site, $contentDir);
    return substr_count(TerminalCms\Page::html($site, $router->route($uri)), '<li>');
}

ok(listed($manySite, $many, '/') === 15,
   'a homepage that names no listing_max prints fifteen of twenty',
   (string) listed($manySite, $many, '/'));

$counts = [3 => 3, 1 => 1, 25 => 20, 0 => 20];
foreach ($counts as $max => $want) {
    $capped = $manySite;
    $capped['listing_max'] = $max;
    ok(listed($capped, $many, '/') === $want,
       sprintf('listing_max %-3d prints %d of twenty', $max, $want),
       (string) listed($capped, $many, '/'));
}

/* a count is a whole number of at least one — everything else is not a count,
   and a homepage with no list on it is not what any of them asked for */
foreach ([-3, 'ten', 2.5, null, true, '5'] as $notACount) {
    $odd = $manySite;
    $odd['listing_max'] = $notACount;
    ok(listed($odd, $many, '/') === 15,
       sprintf('listing_max %-8s is not a count, so fifteen', var_export($notACount, true)),
       (string) listed($odd, $many, '/'));
}

$capped = $manySite;
$capped['listing_max'] = 3;
ok(listed($capped, $many, '/notes') === 12,
   'a category prints its whole category whatever listing_max says',
   (string) listed($capped, $many, '/notes'));

$capped['listing'] = false;
ok(listed($capped, $many, '/') === 0,
   'and a listing_max on a homepage that lists nothing lists nothing',
   (string) listed($capped, $many, '/'));

foreach (glob($many . '/*/*.md') ?: [] as $f) {
    unlink($f);
}
rmdir($many . '/notes');
rmdir($many . '/logs');
rmdir($many);

/* ------------------------------------------------------------- languages
 *
 * A document exists in one language per file, and the language is the suffix
 * on the file name. Everything below is a way for two files that are one
 * document to become two documents, or for one that is not to be split. */
echo "\nlanguages\n";

$codes = ['en', 'sk', 'pt-br'];
$splits = [
    'what-it-is'            => ['what-it-is', ''],
    'what-it-is-sk'         => ['what-it-is', 'sk'],
    'what-it-is-en'         => ['what-it-is', 'en'],
    'notes-pt-br'           => ['notes', 'pt-br'],
    /* a word that looks like a code and is not one, because nobody declared it */
    'install-in-five-minutes' => ['install-in-five-minutes', ''],
    'read-me-de'            => ['read-me-de', ''],
    /* and a name that is nothing but a code is a name */
    '-sk'                   => ['-sk', ''],
];
foreach ($splits as $slug => $want) {
    ok(TerminalCms\Language::split($slug, $codes) === $want,
       sprintf('%-24s -> %s', $slug, implode(' + ', $want)),
       implode(' + ', TerminalCms\Language::split($slug, $codes)));
}

$declared = [
    'the site\'s own language, and no others'   => [['lang' => 'sk'], ['sk']],
    'the site\'s own first, then the rest'      => [['lang' => 'en', 'languages' => ['sk', 'cz']], ['en', 'sk', 'cz']],
    'named twice, listed once'                  => [['lang' => 'en', 'languages' => ['en', 'sk']], ['en', 'sk']],
    'spelled in capitals'                       => [['lang' => 'EN', 'languages' => ['SK']], ['en', 'sk']],
    'what is not a code is not a language'      => [['languages' => ['sk', 'klingon', 5, '../etc']], ['en', 'sk']],
    'a site.php that names none'                => [[], ['en']],
];
foreach ($declared as $what => [$config, $want]) {
    $got = TerminalCms\Site::languages($config);
    ok($got === $want, sprintf('%-42s -> %s', $what, implode(' ', $want)), implode(' ', $got));
}

/* one document in three languages, one of them the site's own */
$box = sys_get_temp_dir() . '/tcms-langs-' . getmypid();
mkdir($box . '/notes', 0755, true);
$write = static function (string $rel, string $title, string $date) use ($box): void {
    file_put_contents($box . '/' . $rel, "---\ntitle: $title\ndate: $date\n---\n\n# $title\n");
};
$write('notes/hello.md',    'Hello',  '2026-02-02');
$write('notes/hello-sk.md', 'Ahoj',   '2026-02-02');
$write('notes/hello-cz.md', 'Dobry',  '2026-02-02');
$write('notes/alone-sk.md', 'Sam',    '2026-02-01');
$write('notes/index.md',    'Notes',  '2026-01-01');
$write('notes/index-sk.md', 'Poznamky', '2026-01-01');

$multi = [
    'title'      => 'many tongues',
    'lang'       => 'en',
    'languages'  => ['sk', 'cz'],
    'categories' => [['slug' => 'notes', 'label' => 'notes']],
];
$mr = new TerminalCms\Router($multi, $box);

$entries = TerminalCms\Listing::forCategory($box, 'notes', TerminalCms\Site::languages($multi));
ok(count($entries) === 2, 'a document in three languages is one entry, not three',
   implode(' ', array_map(static fn ($e) => $e->slug, $entries)));
ok($entries[0]->slug === 'hello' && $entries[0]->title === 'Hello',
   'and it is listed in the site\'s own language', $entries[0]->slug . ' ' . $entries[0]->title);
ok(array_keys($entries[0]->languages) === ['en', 'sk', 'cz'],
   'with every language it exists in, the site\'s own first',
   implode(' ', array_keys($entries[0]->languages)));
ok($entries[0]->languages === ['en' => '/notes/hello', 'sk' => '/notes/hello-sk', 'cz' => '/notes/hello-cz'],
   'each one addressed by its own name', json_encode($entries[0]->languages));

$alone = $entries[1];
ok($alone->slug === 'alone-sk' && $alone->title === 'Sam' && $alone->languages === [],
   'a document written in one language only is listed in that one, with no indicator',
   $alone->slug . ' ' . $alone->title . ' ' . json_encode($alone->languages));

$body = $mr->route('/notes')['body'];
ok(substr_count($body, '<li>') === 2, 'the category page prints one row per document', $body);
ok(str_contains($body, '<span class="languages">(<a href="/notes/hello" class="on">EN</a>'
                     . ' <i>|</i> <a href="/notes/hello-sk">SK</a>'
                     . ' <i>|</i> <a href="/notes/hello-cz">CZ</a>)</span>'),
   'with (EN | SK | CZ) beside it, the one it is printed in marked', $body);

$routes = [
    '/notes/hello'    => ['Hello', 'en'],
    '/notes/hello-sk' => ['Ahoj',  'sk'],
    '/notes/hello-cz' => ['Dobry', 'cz'],
    '/notes/alone-sk' => ['Sam',   'sk'],
];
foreach ($routes as $uri => [$title, $lang]) {
    $r = $mr->route($uri);
    ok($r['status'] === 200 && $r['title'] === $title && $r['lang'] === $lang,
       sprintf('%-16s is %s in %s', $uri, $title, $lang),
       $r['status'] . ' ' . $r['title'] . ' ' . $r['lang']);
    ok(str_contains(TerminalCms\Page::html($multi, $r), '<html lang="' . $lang . '">'),
       'and the page says so', $lang);
}

/* one document is one address per language, and nothing else */
ok($mr->route('/notes/alone')['status'] === 404,
   'a document written only in Slovak is not also at the bare address',
   (string) $mr->route('/notes/alone')['status']);
ok($mr->route('/notes/hello-de')['status'] === 404,
   'and a language a document was never written in is not an address either');

ok(str_contains($mr->route('/notes/hello-sk')['body'],
                '<a href="/notes/hello-sk" class="on">SK</a>'),
   'the document itself carries the same indicator, marking what is being read',
   $mr->route('/notes/hello-sk')['body']);
ok(!str_contains($mr->route('/notes/alone-sk')['body'], 'class="languages"'),
   'and a document with one language carries none');

ok(str_contains($mr->route('/notes')['body'], 'Poznamky') === false
   && str_contains($mr->route('/notes')['body'], 'Notes'),
   'a category reads its own index in the site\'s language', $mr->route('/notes')['body']);

/* every file carrying a suffix, including the site's own language: the bare
   address still works, because that is the address the listing prints */
$suffixed = $box . '-2';
mkdir($suffixed . '/notes', 0755, true);
foreach (['hello-en' => 'Hello', 'hello-sk' => 'Ahoj'] as $n => $t) {
    file_put_contents($suffixed . "/notes/$n.md", "---\ntitle: $t\n---\n\n# $t\n");
}
$sr = new TerminalCms\Router($multi, $suffixed);
$one = $sr->route('/notes/hello');
ok($one['status'] === 200 && $one['title'] === 'Hello',
   'a file named -en answers to the bare address as well', $one['status'] . ' ' . $one['title']);
ok(str_contains($sr->route('/notes')['body'], 'href="/notes/hello"'),
   'and that is the address the listing prints', $sr->route('/notes')['body']);
ok($sr->route('/notes/hello-en')['status'] === 404,
   'and the suffixed address is not a second one for the same language',
   (string) $sr->route('/notes/hello-en')['status']);

/* Two files claiming one language is a mistake in the content, and it resolves
   the same way every time rather than differently per request: the name without
   the suffix is the one the address belongs to. */
$both = $box . '-3';
mkdir($both . '/notes', 0755, true);
foreach (['hello' => 'Plain', 'hello-en' => 'Suffixed'] as $n => $t) {
    file_put_contents($both . "/notes/$n.md", "---\ntitle: $t\n---\n\n# $t\n");
}
$br = new TerminalCms\Router($multi, $both);
ok($br->route('/notes/hello')['title'] === 'Plain',
   'two files in one language: the unsuffixed name holds the address',
   $br->route('/notes/hello')['title']);
ok(substr_count($br->route('/notes')['body'], '<li>') === 1
   && !str_contains($br->route('/notes')['body'], 'class="languages"'),
   'and they are still one document, with one language to indicate',
   $br->route('/notes')['body']);
ok($br->route('/notes/hello-en')['status'] === 404,
   'and the suffixed file is not reachable at a second address',
   (string) $br->route('/notes/hello-en')['status']);

/* the site as it was before any of this: no suffixes, no indicators */
$single = ['categories' => [['slug' => 'notes', 'label' => 'notes']]];
$plain  = new TerminalCms\Router($single, $box);
ok($plain->route('/notes/hello')['status'] === 200
   && $plain->route('/notes/hello-sk')['status'] === 200,
   'a site that declares no languages serves every file by its own name');
ok(!str_contains($plain->route('/notes')['body'], 'class="languages"'),
   'and prints no indicators, because it has nothing to indicate',
   $plain->route('/notes')['body']);
ok(substr_count($plain->route('/notes')['body'], '<li>') === 5,
   'each file being a document of its own — index-sk.md included, because a
    site that has not declared Slovak has no way to know what that is',
   $plain->route('/notes')['body']);

foreach (glob($box . '*/notes/*.md') ?: [] as $f) {
    unlink($f);
}
foreach ([$box, $suffixed, $both] as $dir) {
    rmdir($dir . '/notes');
    rmdir($dir);
}

/* ------------------------------------------------------------- the meta bar */
echo "\nmeta\n";
[, $metaLines] = Markdown::parse("---\ntitle: A title\ncategory: about\ndate: 2026-01-02\n---\n\n# A title\n\nText.\n");
$metaHtml = Renderer::render($metaLines);
ok(str_contains($metaHtml, '<h1>A title</h1>' . "\n" . '<div class="doc-meta">'),
   'the meta sits directly under the title', $metaHtml);
ok(str_contains($metaHtml, 'category: about · date: 2026-01-02'),
   'and carries every key the document declared', $metaHtml);
ok(!str_contains($metaHtml, 'title: A title'),
   'except the title, which is the title', $metaHtml);
ok(!str_contains(Renderer::render($metaLines, false), 'doc-meta'),
   'and can be left off entirely');

[, $noH1] = Markdown::parse("---\ndate: 2026-01-02\n---\n\nJust a paragraph.\n");
ok(str_starts_with(Renderer::render($noH1), '<div class="doc-meta">'),
   'a document with no title puts its meta where the title would have been',
   Renderer::render($noH1));

[, $bare] = Markdown::parse("# Only a heading\n");
ok(!str_contains(Renderer::render($bare), 'doc-meta'),
   'a document with no meta has no meta bar');

$r = $router->route('/about/everything-is-a-line');
ok(str_contains($r['body'], 'Everything is a line'), 'the document actually renders');
ok(!str_contains($r['body'], '<time>'), 'the date is not repeated in the document footer', $r['body']);
ok(str_contains($r['body'], '<table>'), 'the table renders as a table');
ok(str_contains($r['body'], '<details class="outsec">'), 'output is folded by default');
ok(!str_contains($r['body'], '<details class="outsec" open'), 'output is not open by default');

/* -------------------------------------------------------------- the footer */
echo "\nfooter\n";

/** The footer element of a page, or '' when the page has none. */
function foot(array $site, array $route): string
{
    $html = TerminalCms\Page::html($site, $route);
    return preg_match('~<footer.*?</footer>~s', $html, $m) === 1 ? $m[0] : '';
}

$home = $router->route('/');

$withLinks = $site;
$withLinks['footer'] = [
    '[a link](https://example.com/) is **here**',
    'second line',
];
$f = foot($withLinks, $home);
ok(str_contains($f, '<a href="https://example.com/" rel="noopener noreferrer">a link</a>'),
   'the footer carries links', $f);
ok(str_contains($f, '<strong>here</strong>') && str_contains($f, 'second line'),
   'and inline markup, one line per string', $f);
ok(!str_contains($f, (string) $site['title']) && !str_contains($f, (string) $site['tagline']),
   'and nothing the instance did not put there', $f);

$evilFoot = $site;
$evilFoot['footer'] = '<script>alert(1)</script> [x](javascript:alert(1))';
$f = foot($evilFoot, $home);
ok(!str_contains($f, '<script') && !str_contains($f, 'javascript:'),
   'a footer cannot put markup on the page either', $f);

/* the tagline is read in the top bar and indexed as the description */
$taglined = TerminalCms\Page::html($site, $home);
ok(str_contains($taglined, '<span class="tagline">' . $site['tagline'] . '</span>'),
   'the tagline is in the top bar', $taglined);
ok(str_contains($taglined, '<meta name="description" content="' . $site['tagline'] . '">'),
   'and is still the page description');
$noTag = $site;
$noTag['tagline'] = '';
$plain = TerminalCms\Page::html($noTag, $home);
ok(!str_contains($plain, 'class="tagline"') && !str_contains($plain, 'name="description"'),
   'an instance with no tagline gets neither', $plain);

/* the two inline points on the page, and the one config value that reaches it
   as CSS rather than as text */
echo "\nthe page shell\n";
$nonced = TerminalCms\Page::html($site, $home, 'r4nd0m+va1ue/=');
ok(substr_count($nonced, 'nonce="r4nd0m+va1ue/="') === 2
   && str_contains($nonced, '<script nonce="r4nd0m+va1ue/=">')
   && str_contains($nonced, '<style nonce="r4nd0m+va1ue/=">'),
   'the style block and the script both carry the nonce they are given', $nonced);
ok(!str_contains(TerminalCms\Page::html($site, $home), 'nonce='),
   'and neither carries an empty one when no nonce is given');
ok(str_contains($nonced, '(function () {') && !str_contains($nonced, '$nonceAttr'),
   'the script is emitted as written, not read as PHP', $nonced);

$accents = [
    '#d9a05f'                          => '#d9a05f',
    '#ABCDEF'                          => '#ABCDEF',
    'red'                              => '#d9a05f',
    '#fff'                             => '#d9a05f',
    '#d9a05f;background:url(//evil)'   => '#d9a05f',
    '}html{display:none'               => '#d9a05f',
];
foreach ($accents as $given => $want) {
    $accented = $site;
    $accented['accent'] = $given;
    ok(str_contains(TerminalCms\Page::html($accented, $home), '<style>:root{--accent:' . $want . '}</style>'),
       sprintf('accent %-32s -> %s', var_export($given, true), $want));
}

$noFoot = $site;
$noFoot['footer'] = '';
ok(foot($noFoot, $home) === '', 'an empty footer is no footer element at all');
unset($noFoot['footer']);
ok(foot($noFoot, $home) === '', 'and so is a site.php that names no footer');

/* link_open, on the page: the body and the footer are one instance answering
   one question, so they cannot disagree about where a link opens */
$scratch = sys_get_temp_dir() . '/tcms-open-' . getmypid();
mkdir($scratch . '/notes', 0755, true);
file_put_contents($scratch . '/notes/links.md',
    "---\ntitle: Links\n---\n\n# Links\n\n[away](https://example.com/) and [home](/notes/other).\n");
$openSite = [
    'title' => 'open', 'categories' => [['slug' => 'notes', 'label' => 'notes']],
    'footer' => '[foot](https://example.com/)',
];
$openRouter = new TerminalCms\Router($openSite, $scratch);

$tabbed = $openSite;
$tabbed['link_open'] = 'tab';
$tabRouter = new TerminalCms\Router($tabbed, $scratch);
$page = TerminalCms\Page::html($tabbed, $tabRouter->route('/notes/links'));
ok(str_contains($page, '<a href="https://example.com/" rel="noopener noreferrer" target="_blank">away</a>'),
   "'tab' opens a link that leaves the site in a new one", $page);
ok(str_contains($page, '<a href="/notes/other">home</a>'),
   'and leaves a link to this site where it is', $page);
ok(substr_count($page, 'target="_blank"') === 2
   && str_contains(foot($tabbed, $tabRouter->route('/notes/links')), 'target="_blank"'),
   'and the footer link opens the same way the body link does', $page);

foreach (['here', 'yes', 'tabs', ''] as $mode) {
    $elsewhere = $openSite;
    $elsewhere['link_open'] = $mode;
    /* its own router: the body is rendered from the site the router was built
       with, so reading one router's page under another site proves nothing */
    $elseRouter = new TerminalCms\Router($elsewhere, $scratch);
    ok(!str_contains(TerminalCms\Page::html($elsewhere, $elseRouter->route('/notes/links')), 'target='),
       sprintf('link_open %-7s puts no target on the page', var_export($mode, true)));
}
ok(!str_contains(TerminalCms\Page::html($openSite, $openRouter->route('/notes/links')), 'target='),
   'and neither does a site.php that names none');

/* the logo: an instance's own picture in the brand link */
/** The brand link of a page. */
function brand(array $site, array $route): string
{
    $html = TerminalCms\Page::html($site, $route);
    return preg_match('~<a class="brand".*?</a>~s', $html, $m) === 1 ? $m[0] : '';
}
$logos = [
    '/media/logo.svg'        => '/media/logo.svg',
    '  /media/logo.svg  '    => '/media/logo.svg',
    './media/logo.svg'       => '/media/logo.svg',
    'https://evil.example/x.svg' => '/media/x.svg',
    '//evil.example/x.svg'   => '/media/x.svg',
    '/media/../../secret.svg' => '/media/secret.svg',
];
foreach ($logos as $given => $want) {
    $logoed = $site;
    $logoed['logo'] = $given;
    ok(brand($logoed, $home) === '<a class="brand" href="/"><img class="logo" src="' . $want . '" alt="'
       . $site['title'] . '">' . $site['title'] . '</a>',
       sprintf('logo %-28s -> %s', var_export($given, true), $want), brand($logoed, $home));
}

/* the example instance names a picture and an icon of its own, and these
   cases are about an instance that names neither */
$noBrand = $site;
unset($noBrand['logo'], $noBrand['favicon']);

$bare = brand($noBrand, $home);
ok($bare === '<a class="brand" href="/">' . $site['title'] . '</a>',
   'an instance with no logo has the brand link it always had', $bare);
$shell = TerminalCms\Page::html($noBrand, $home);
foreach (['' => 'an empty one', '   ' => 'a blank one', 'true' => 'one that is not a path',
          'array' => 'one that is not even a string'] as $none => $what) {
    $blank = $noBrand;
    $blank['logo'] = $none === 'array' ? ['/media/logo.svg'] : ($none === 'true' ? true : $none);
    ok(TerminalCms\Page::html($blank, $home) === $shell,
       'and ' . $what . ' leaves the whole page byte-identical to it');
}

/* the favicon: the icon in the reader's tab, read the way the logo's src is */
/** The icon link of a page, or '' when the page emits none. */
function icon(array $site, array $route): string
{
    $html = TerminalCms\Page::html($site, $route);
    return preg_match('~<link rel="icon"[^>]*>~', $html, $m) === 1 ? $m[0] : '';
}
$icons = [
    '/favicon.ico'      => '<link rel="icon" href="/favicon.ico" type="image/x-icon">',
    '  /favicon.ico  '  => '<link rel="icon" href="/favicon.ico" type="image/x-icon">',
    '/media/icon.png'   => '<link rel="icon" href="/media/icon.png" type="image/png">',
    './media/icon.SVG'  => '<link rel="icon" href="/media/icon.SVG" type="image/svg+xml">',
    'icon.gif'          => '<link rel="icon" href="/media/icon.gif" type="image/gif">',
    '/media/icon.weird' => '<link rel="icon" href="/media/icon.weird">',
    '/media/icon'       => '<link rel="icon" href="/media/icon">',
];
foreach ($icons as $given => $want) {
    $iconed = $site;
    $iconed['favicon'] = $given;
    ok(icon($iconed, $home) === $want,
       sprintf('favicon %-20s -> %s', var_export($given, true), $want), icon($iconed, $home));
}

/* the four shapes the href allowlist refuses, each reduced to the file it
   names — by the one media-path rule, so the icon and the logo agree */
foreach ([
    'a protocol-relative URL' => '//evil.example/x.ico',
    'a backslash'             => '\\\\evil.example\\x.ico',
    'a climb'                 => '/media/../../etc/x.ico',
    'a control character'     => "\x01/media/x.ico",
] as $shape => $given) {
    $both = $site;
    $both['favicon'] = $given;
    $both['logo']    = $given;
    ok(TerminalCms\Site::favicon($both) === '/media/x.ico'
       && TerminalCms\Site::logo($both) === TerminalCms\Site::favicon($both),
       sprintf('a favicon naming %-23s is the file it names, as the logo is', $shape),
       TerminalCms\Site::favicon($both));
}

/* saying nothing and saying none are different answers */
ok(icon($noBrand, $home)
   === '<link rel="icon" href="' . TerminalCms\Site::FAVICON . '" type="image/x-icon">',
   'an instance that names no favicon gets the icon the archive ships', icon($noBrand, $home));
foreach ([['', 'an empty favicon'], ['   ', 'a blank one'], [true, 'one that is not a path'],
          [['/favicon.ico'], 'one that is not even a string']] as [$none, $what]) {
    $noIcon = $noBrand;
    $noIcon['favicon'] = $none;
    ok(icon($noIcon, $home) === '', $what . ' emits no icon link at all', icon($noIcon, $home));
}

/* the two assets the archive ships, where the shell says they are */
ok(is_file($root . '/site/public' . TerminalCms\Site::FAVICON),
   'the icon a page names by default is a file in public/');
foreach (['logo' => TerminalCms\Site::logo($site), 'favicon' => TerminalCms\Site::favicon($site)]
         as $key => $named) {
    ok($named !== '' && is_file($root . '/site/public' . $named),
       'the ' . $key . ' the example instance names is a file in public/', $named);
}

unlink($scratch . '/notes/links.md');
rmdir($scratch . '/notes');
rmdir($scratch);

echo "\nlinks and media\n";
/* a heading is linkable, and two headings with the same words are two links */
[, $twice] = Markdown::parse("## Notes\n\na\n\n## Notes\n\nb\n");
ok(str_contains(Renderer::render($twice), '<h2 id="notes">')
   && str_contains(Renderer::render($twice), '<h2 id="notes-2">'),
   'two headings with the same words get two ids', Renderer::render($twice));

/* an image path is a URL into public/media, never a way out of it */
[, $img] = Markdown::parse("![a](../../etc/passwd.png?v=1)\n");
ok(str_contains(Renderer::render($img), 'src="/media/passwd.png"'),
   'an image path cannot climb out of media/', Renderer::render($img));

/* and cannot become an address on somebody else's origin */
foreach (['//evil.example/x.png', '\\\\evil.example/x.png', '/media/../../etc/passwd.png'] as $src) {
    [, $one] = Markdown::parse("![a]($src)\n");
    $out = Renderer::render($one);
    ok(preg_match('~src="/media/[A-Za-z0-9._-]+"~', $out) === 1,
       sprintf('%-30s is a name under media/', $src), $out);
}

/* the one rule, in every form a relative path takes: ./ is the document's own
   directory and comes off, and anything else that is not an absolute path is
   a name under media/ — a climb included, however short */
$relative = [
    './media/x.png'  => '/media/x.png',
    'media/x.png'    => '/media/x.png',
    'x.png'          => '/media/x.png',
    '../x.png'       => '/media/x.png',
    '../../x.png'    => '/media/x.png',
    './../x.png'     => '/media/x.png',
    '.hidden.png'    => '/media/.hidden.png',
    '/x.png'         => '/x.png',
];
foreach ($relative as $src => $want) {
    ok(Renderer::mediaUrl($src) === $want,
       sprintf('%-16s -> %s', $src, $want), Renderer::mediaUrl($src));
}

/* ------------------------------------------- the built-in server serves assets */
echo "\ndev server\n";
$port = 8100 + (getmypid() % 400);
$cfg  = $root . '/site/site.php';
$temp = false;
if (!is_file($cfg)) {
    copy($root . '/site/site.php.example', $cfg);
    $temp = true;
}

/* argv form, so no shell sits between us and the server we have to stop */
$cmd = [PHP_BINARY, '-S', "127.0.0.1:$port",
        '-t', $root . '/site/public', $root . '/site/public/index.php'];
$proc = proc_open($cmd, [1 => ['file', '/dev/null', 'w'], 2 => ['file', '/dev/null', 'w']], $pipes);

$base = "http://127.0.0.1:$port";
$up   = false;
for ($i = 0; $i < 40 && !$up; $i++) {
    usleep(100000);
    $up = @file_get_contents($base . '/') !== false;
}

if (!$up) {
    ok(false, 'development server started on port ' . $port);
} else {
    /* the bug this exists for: a router script sees every request, including
       real files, so index.php has to hand static assets back to the server */
    foreach (['/theme.css' => 'text/css', '/site.css' => 'text/css',
              '/favicon.ico' => 'image/'] as $path => $type) {
        $body = @file_get_contents($base . $path);
        $head = implode(' ', $http_response_header ?? []);
        ok(is_string($body) && !str_contains($body, '<!doctype html'),
           "$path is served as a file, not the 404 page");
        ok(str_contains(strtolower($head), $type), "$path has content-type $type", $head);
    }
    $doc = @file_get_contents($base . '/about/everything-is-a-line');
    ok(is_string($doc) && str_contains($doc, '<table>'), 'documents still route');
    ok(@file_get_contents($base . '/nope') === false, 'unknown paths still 404');
}

if (is_resource($proc)) {
    proc_terminate($proc);
    proc_close($proc);
}
if ($temp) {
    unlink($cfg);
}

/* ------------------------------------------------------- dangerous calls */
echo "\nsource\n";

/* Every file, every term it must not contain, as "file: term" lines. */
function scan(array $files, array $terms): array
{
    $found = [];
    foreach ($files as $f) {
        $code = (string) file_get_contents($f);
        foreach ($terms as $t) {
            if (str_contains($code, $t)) {
                $found[] = basename($f) . ': ' . $t;
            }
        }
    }
    return $found;
}

$found = scan(
    array_merge(glob($root . '/site/src/*.php') ?: [], [$root . '/site/public/index.php']),
    ['eval(', 'exec(', 'shell_exec', 'system(', 'passthru', 'popen',
     'unserialize(', 'extract(', 'assert(', '$_GET', '$_POST', '$_COOKIE',
     'file_put_contents', 'fwrite', 'unlink', 'session_start']
);
ok($found === [], 'the site reads, and does nothing else', implode("\n", $found));

/* The editor's one request is an <img src> the browser issues from markup, which
   a source scan cannot see; this says the other half, that the page opens no
   connection itself. docs/security.md says what the markup causes.

   The two hand-written scripts are read. editor/langs.js is generated from
   shared/langs.json and is data, not code: its js table names fetch and eleven
   language tables name import, as words to colour. */
$found = scan(
    [$root . '/editor/editor.js', $root . '/editor/ui.js'],
    ['fetch(', 'XMLHttpRequest', 'WebSocket', 'EventSource', 'sendBeacon', 'import(']
);
ok($found === [], 'the editor opens no connection', implode("\n", $found));

echo "\n$pass passed, $fail failed\n";
exit($fail === 0 ? 0 : 1);
