ok(str_contains(Renderer::render($twice), '<h2 id="notes">')
   && str_contains(Renderer::render($twice), '<h2 id="notes-2">'),
   'two headings with the same words get two ids', Renderer::render($twice));

/* an image path is a URL into public/media, never a way out of it */
[, $img] = Markdown::parse("![a](../../etc/passwd.png?v=1)\n");
ok(str_contains(Renderer::render($img), 'src="/media/passwd.png"'),
   'an image path cannot climb out of media/', Renderer::render($img));

/* and cannot become an address on somebody else's origin */
foreach (['//evil.example/x.png', '\\\\evil.example/x.png', '/media/../../etc/passwd.png'] as $src) {
    [, $one] = Markdown::parse("![a]($src)\n");
    $out = Renderer::render($one);
    ok(preg_match('~src="/media/[A-Za-z0-9._-]+"~', $out) === 1,
       sprintf('%-30s is a name under media/', $src), $out);
}

/* the one rule, in every form a relative path takes: ./ is the document's own
   directory and comes off, and anything else that is not an absolute path is
   a name under media/ — a climb included, however short */
$relative = [
    './media/x.png'  => '/media/x.png',
    'media/x.png'    => '/media/x.png',
    'x.png'          => '/media/x.png',
    '../x.png'       => '/media/x.png',
    '../../x.png'    => '/media/x.png',
    './../x.png'     => '/media/x.png',
    '.hidden.png'    => '/media/.hidden.png',
    '/x.png'         => '/x.png',
];
foreach ($relative as $src => $want) {
    ok(Renderer::mediaUrl($src) === $want,
       sprintf('%-16s -> %s', $src, $want), Renderer::mediaUrl($src));
}

/* ------------------------------------------------------------ the base path */
echo "\nbase path\n";

$urls = [
    'https://example.gitlab.io/proj/' => '/proj',
    'https://example.gitlab.io/proj'  => '/proj',
    'https://example.gitlab.io/a/b/'  => '/a/b',
    'https://example.gitlab.io/'      => '',
    'https://example.gitlab.io'       => '',
    '/'                               => '',
    ''                                => '',
    '/proj/?x=1#y'                    => '/proj',
];
foreach ($urls as $url => $want) {
    ok(BasePath::fromUrl($url)->path === $want,
       sprintf('%-32s is the Base Path %s', var_export($url, true), var_export($want, true)),
       BasePath::fromUrl($url)->path);
}
foreach (['https://h//evil.example/', 'https://h/a/../b', 'https://h/./a', 'https://h/a\\b', "/a\x01b", '/a b'] as $url) {
    $threw = false;
    try {
        BasePath::fromUrl($url);
    } catch (InvalidArgumentException) {
        $threw = true;
    }
    ok($threw, sprintf('%-28s is not a Base Path', var_export($url, true)));
}

$proj = new BasePath('/proj', true);
ok($proj->page('') === '/proj/' && $proj->page('guides') === '/proj/guides/'
   && $proj->page('guides/a-b') === '/proj/guides/a-b/',
   'a built page is addressed under the Base Path, with the trailing slash',
   $proj->page('') . ' ' . $proj->page('guides'));
$here = new BasePath();
ok($here->page('') === '/' && $here->page('guides') === '/guides' && $here->local('/theme.css') === '/theme.css',
   'and the request-time site\'s addresses start at / and end where the name does',
   $here->page('') . ' ' . $here->page('guides'));

/* a Link and an Image written from the site's root are written from the Base
   Path's; everything that is not a local address is left as it is */
$hrefs = [
    '[x](/guides/a)'              => 'href="/proj/guides/a"',
    '[x](/guides/a#part)'         => 'href="/proj/guides/a#part"',
    '[x](#part)'                  => 'href="#part"',
    '[x](https://example.com/a)'  => 'href="https://example.com/a"',
    '[x](mailto:you@example.com)' => 'href="mailto:you@example.com"',
];
foreach ($hrefs as $case => $want) {
    ok(str_contains(Renderer::inline($case, 'here', $proj), $want),
       sprintf('%-30s -> %s', $case, $want), Renderer::inline($case, 'here', $proj));
}
ok(!str_contains(Renderer::inline('[x](//evil.example/a)', 'here', $proj), 'href='),
   'and a protocol-relative Href is still no link at all');
foreach (['![a](/media/x.png)' => 'src="/proj/media/x.png"', '![a](x.png)' => 'src="/proj/media/x.png"'] as $case => $want) {
    [, $one] = Markdown::parse($case . "\n");
    ok(str_contains(Renderer::render($one, true, 'here', $proj), $want),
       sprintf('%-30s -> %s', $case, $want), Renderer::render($one, true, 'here', $proj));
}

/* the one value reaches the whole shell: navigation, brand, stylesheets, the
   icon, the logo, a footer Link and the Mermaid address */
$built = TerminalCms\Page::html(
    ['footer' => '[home](/about)'] + $site,
    (new TerminalCms\Router($site, $root . '/site/content', $proj))->route('/about/everything-is-a-line'),
    '', $proj
);
