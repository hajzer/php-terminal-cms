    '/about/what-it-is'                 => 'a741e8a38cf3bd75f4f2b1943db43f3b88ccb98bc5dd952d4662d9e58ca540f9',
    '/about/what-it-is-sk'              => 'eb36c0ecba5128ec3d6efc64d96138e58f93037085aeb8c5f272a2a9e82fac80',
